---
import Base from '../../layouts/Base.astro';
import { faq } from '../../lib/faq';
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
---
<Base solid title="FAQ | Mavalli Biryani Jayanagar" description="Ordering, delivery, hours, vegetarian dishes, Sunday specials, payments, refunds and allergies at Mavalli Biryani Jayanagar." crumbs={[['FAQ','/faq/']]} jsonld={[ld]}>
  <div class="mx-auto max-w-3xl px-4 pb-20 pt-6"><h1 class="h-rule font-display text-4xl sm:text-5xl">Good to know</h1>
    <div class="mt-8 space-y-3">{faq.map(([q, a]) => <details class="card p-4"><summary class="flex items-center justify-between gap-4 font-semibold">{q}<span class="plus text-2xl text-copper" aria-hidden="true">+</span></summary><p class="mt-3">{a}</p></details>)}</div></div>
</Base>
