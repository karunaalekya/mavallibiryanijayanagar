---
// Shows a real Google rating only. Renders nothing until googleRating + googleReviews are set in outlet.config.json.
import { cfg } from '../lib/site';
const show = cfg.googleRating && cfg.googleReviews;
---
{show && <section class="band band-ink py-14" aria-labelledby="rev-h"><div class="mx-auto flex max-w-[1440px] flex-wrap items-center justify-between gap-6 px-5 lg:px-12">
  <div><h2 id="rev-h" class="brush brush-l font-display">What guests say</h2>
    <p class="mt-4 text-xl"><b class="text-gold" style="font-size:2.2rem">{cfg.googleRating}</b> <span aria-hidden="true" class="text-gold">★</span><span class="sr-only"> out of 5</span> on Google · {cfg.googleReviews} reviews</p></div>
  <div class="flex flex-wrap gap-3">{cfg.googleReviewsUrl && <a href={cfg.googleReviewsUrl} target="_blank" rel="noopener" class="btn btn-fire" data-evt="reviews_click">Read reviews</a>}{cfg.googleReviewUrl && <a href={cfg.googleReviewUrl} target="_blank" rel="noopener" class="btn btn-line" data-evt="review_write_click">Write a review</a>}</div>
</div></section>}
