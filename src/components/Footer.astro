---
import { cfg, callNum, dirLink, waLink } from '../lib/site';
const links = [['Home','/'],['Menu','/menu/'],['About Us','/about/'],['Order Now','/order/'],['Contact','/contact/'],['Gallery','/gallery/'],['Catering','/catering/'],['FAQ','/faq/']];
const legal = [['Privacy','/privacy/'],['Terms','/terms/'],['Refund & Cancellation','/refund/'],['Cookies','/cookies/']];
const ico = {
  ig: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/>',
  wa: '<path d="M3.5 20.5l1.3-4.6A8.5 8.5 0 1 1 8 19.2z"/><path d="M9 8.5c.3 2.6 2.900 5.500 6 6.500l1.300-1.400-2-1-.9.800c-.9-.4-1.800-1.300-2.200-2.200l.8-.9-1-2z" fill="currentColor" stroke="none"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.500 7 8.500 6.500L20.500 7"/>',
  pin: '<path d="M12 21s7-6.100 7-11.500A7 7 0 0 0 5 9.500C5 14.900 12 21 12 21z"/><circle cx="12" cy="9.500" r="2.500"/>',
};
const soc = [
  cfg.instagram && ['Instagram', cfg.instagram, ico.ig, true],
  cfg.whatsapp && ['WhatsApp', waLink(), ico.wa, false],
  cfg.email && ['Email', `mailto:${cfg.email}`, ico.mail, false],
  ['Directions', dirLink, ico.pin, true],
].filter(Boolean);
---
<footer class="ftr bg-maroon text-ivory">
  <div class="ftr-main mx-auto max-w-[1440px] px-5 lg:px-12">
    <a href="/" class="ftr-brand"><img src="/img/logo-sm.webp" alt="" width="99" height="64" loading="lazy"><span><b class="font-display">Mavalli Biryani</b><small>JAYANAGAR · TASTE OF 1952</small></span></a>
    <nav aria-label="Footer" class="ftr-nav"><ul>{links.map(([l,h]) => <li><a href={h}>{l}</a></li>)}</ul></nav>
    <ul class="ftr-soc" aria-label="Contact and social">{soc.map(([l,h,d,ext]: any) => <li><a href={h} aria-label={l} title={l} {...(ext ? { target: '_blank', rel: 'noopener' } : {})}><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={d} /></a></li>)}</ul>
  </div>
  <div class="ftr-info mx-auto max-w-[1440px] px-5 lg:px-12" id="visit">
    <address class="not-italic">{cfg.address.line}, {cfg.address.city} {cfg.address.pin}</address>
    {callNum && <a href={`tel:+91${callNum}`}>Call +91 {callNum}</a>}
    {cfg.hours && <span>{cfg.hours}</span>}
  </div>
  <div class="ftr-legal mx-auto max-w-[1440px] px-5 lg:px-12">
    <ul>{legal.map(([l,h]) => <li><a href={h}>{l}</a></li>)}{cfg.ga4 && <li><button type="button" class="flink" data-cookie-settings>Cookie settings</button></li>}</ul>
    <p>{cfg.legalName ?? cfg.name} · FSSAI Reg. No. {cfg.fssai}{cfg.gstin && <> · GSTIN {cfg.gstin}</>} · Grievance contact: {cfg.grievanceOfficer ?? 'Outlet Manager'}, <a href={`mailto:${cfg.email}`} class="underline">{cfg.email}</a> · © {new Date().getFullYear()} {cfg.name} · <span class="devby">Developed by <a href="https://bjnexusai.com" target="_blank" rel="noopener" class="font-semibold text-gold underline decoration-gold/40 underline-offset-4 hover:decoration-gold">BJNEXUS AI</a></span></p>
  </div>
</footer>
