---
import reels from '../data/reels.json';
import { cfg } from '../lib/site';
const items = reels.items;
---
<section id="reels" class="reels relative overflow-hidden bg-ink py-16 text-ivory lg:py-24" aria-labelledby="reels-h">
  <div class="mx-auto grid max-w-[1440px] items-center gap-8 px-5 lg:grid-cols-[minmax(0,.8fr)_minmax(0,1.7fr)] lg:gap-12 lg:px-12">
    <div class="max-w-[40ch]">
      <h2 id="reels-h" class="h-rule font-display text-3xl sm:text-4xl lg:text-5xl">{reels.heading}</h2>
      <p class="mt-5 text-cream/85">{reels.intro}</p>
      <a href={cfg.instagram} target="_blank" rel="noopener" class="btn btn-line mt-6" data-evt="instagram_click">Follow @mavallibiryani.jayanagar</a>
      {items.length > 2 && <div class="mt-6 hidden gap-2 lg:flex"><button type="button" class="rbtn" data-dir="-1" aria-label="Previous video">←</button><button type="button" class="rbtn" data-dir="1" aria-label="Next video">→</button></div>}
    </div>
    <ul id="rrail" class="rrail -mx-5 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-3 lg:mx-0 lg:gap-5 lg:px-0" aria-label="Instagram videos">
      {items.map((r) => (
        <li class="rcard snap-start">
          <figure class="rframe" style={`aspect-ratio:${r.ratio}`}>
            <video class="rvid" preload="none" playsinline loop muted poster={r.poster} aria-label={r.title}>
              <source src={r.video} type="video/mp4">
            </video>
            <button type="button" class="rplay" aria-label={`Play video: ${r.title}`} data-state="paused">
              <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
            </button>
          </figure>
          <p class="mt-3 font-display text-lg">{r.title}</p>
        </li>
      ))}
      <li class="rcard snap-start">
        <a href={cfg.instagram} target="_blank" rel="noopener" class="rframe rmore" style="aspect-ratio:1 / 1" data-evt="instagram_click">
          <svg viewBox="0 0 24 24" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg>
          <span class="font-display text-2xl">More videos on Instagram</span>
          <span class="text-sm text-cream/80">@mavallibiryani.jayanagar</span>
        </a>
      </li>
    </ul>
  </div>
</section>
<script>
  const vids = Array.from(document.querySelectorAll<HTMLVideoElement>('.rvid'));
  vids.forEach(v => {
    const b = v.parentElement!.querySelector('.rplay') as HTMLButtonElement;
    const sync = () => { b.dataset.state = v.paused ? 'paused' : 'playing'; b.setAttribute('aria-label', (v.paused ? 'Play video: ' : 'Pause video: ') + (v.getAttribute('aria-label') ?? '')); };
    const toggle = () => { if (v.paused) { vids.forEach(o => o !== v && o.pause()); v.play().then(sync).catch(sync); (window as any).dataLayer?.push({ event: 'reel_play' }); } else v.pause(); };
    b.addEventListener('click', toggle); v.addEventListener('click', toggle);
    v.addEventListener('play', sync); v.addEventListener('pause', sync);
    new IntersectionObserver(([en]) => { if (!en.isIntersecting && !v.paused) v.pause(); }, { threshold: .2 }).observe(v);
  });
  const rail = document.getElementById('rrail');
  document.querySelectorAll<HTMLButtonElement>('.rbtn').forEach(b => b.addEventListener('click', () => rail?.scrollBy({ left: Number(b.dataset.dir) * (rail.clientWidth / 2), behavior: 'smooth' })));
</script>
