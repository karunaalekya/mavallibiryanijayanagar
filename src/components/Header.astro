---
import { cfg, waLink } from '../lib/site';
const path = Astro.url.pathname;
const wa = waLink();
const { solid = false } = Astro.props;
const links = cfg.nav.filter(([l]: string[]) => l !== 'Order Now');
const order = cfg.nav.find(([l]: string[]) => l === 'Order Now');
---
<header id="hdr" data-solid={solid ? "1" : undefined} class={`hdr fixed inset-x-0 top-0 z-40 text-ivory ${solid ? "solid" : ""}`}>
  <div class="hdr-in mx-auto flex max-w-[1240px] items-start justify-between gap-3 lg:grid lg:grid-cols-[1fr_auto_1fr] lg:items-center">
    <a href="/" aria-label={cfg.name} class="logo-badge"><span class="logo-art"><img src="/img/logo.webp" srcset="/img/logo-sm.webp 360w, /img/logo.webp 720w" sizes="(min-width:1024px) 13rem, 40vw" alt="Mavalli Biryani, Taste of 1952" width="720" height="463" fetchpriority="high"><canvas id="logo-fx" class="logo-fx" aria-hidden="true"></canvas></span></a>
    <a href="/" class="hdr-word" tabindex="-1" aria-hidden="true"><b>Mavalli Biryani</b><small>Jayanagar</small></a>
    <nav class="hdr-nav hidden items-center justify-center gap-1 lg:col-start-2 lg:flex" aria-label="Main">
      {links.map(([l,h]: string[]) => <a href={h} aria-current={path===h?'page':undefined} class="navlink">{l}</a>)}
    </nav>
    <div class="hidden justify-end lg:col-start-3 lg:flex">{order && <a href={order[1]} aria-current={path===order[1]?'page':undefined} class="btn btn-fire hdr-cta" data-evt="order_click">{order[0]}</a>}</div>
    <details id="mnav" class="relative ml-auto mt-1 lg:hidden">
      <summary class="burger" aria-label="Menu"><span></span><span></span><span></span></summary>
      <nav class="mpanel" aria-label="Mobile">
        {links.map(([l,h]: string[]) => <a href={h} aria-current={path===h?'page':undefined} class="mlink">{l}</a>)}
        {order && <a href={order[1]} aria-current={path===order[1]?'page':undefined} class="mlink mlink-cta" data-evt="order_click">{order[0]}</a>}
        <a href={wa} class="btn btn-wa mt-3 w-full" data-evt="whatsapp_click">Order on WhatsApp</a>
      </nav>
    </details>
  </div>
</header>
<script>
  const h = document.getElementById('hdr')!;
  const d = document.getElementById('mnav') as HTMLDetailsElement;
  let last = 0;
  const on = () => {
    const y = scrollY;
    if (h.dataset.lock) { last = y; return; }   // menu tab jump in progress: keep nav state fixed
    if (!h.dataset.solid) h.classList.toggle('solid', y > 40 || d.open);
    h.classList.toggle('away', y > 300 && y > last + 4 && !d.open);
    if (y < last - 4) h.classList.remove('away');
    last = y;
  };
  addEventListener('scroll', on, { passive: true }); on();
  d.addEventListener('toggle', on);
  document.addEventListener('click', (e) => { if (d.open && !d.contains(e.target as Node)) d.open = false; });
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && d.open) { d.open = false; d.querySelector('summary')!.focus(); } });
  d.querySelectorAll('a').forEach(a => a.addEventListener('click', () => { d.open = false; }));
</script>

<script>
  const cv = document.getElementById('logo-fx') as HTMLCanvasElement | null;
  if (cv && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const g = cv.getContext('2d')!;
    // TUNE THESE: positions as fractions of the logo image (0..1)
    const POT  = { x: .505, y: .17, w: .13 };   // biryani handi rim: steam starts here
    const FIRE = { x: .505, y: .335, w: .2 };   // wood sticks: flames start here
    const TOP = .26;                            // canvas extends 26% above the logo (matches CSS)
    let W = 0, H = 0, dpr = 1, last = 0, acc = 0, raf = 0;
    const fit = () => { dpr = Math.min(devicePixelRatio || 1, 1.5); W = cv.clientWidth; H = cv.clientHeight; cv.width = W * dpr; cv.height = H * dpr; };
    fit(); addEventListener('resize', fit);
    const X = (f: number) => f * W, Y = (f: number) => ((f + TOP) / (1 + TOP)) * H;
    const R = (a: number, b: number) => a + Math.random() * (b - a);
    type P = { x: number; y: number; vx: number; vy: number; age: number; life: number; r: number; ph: number };
    const flames: P[] = [], steam: P[] = [], sparks: P[] = [];

    const loop = (t: number) => {
      raf = requestAnimationFrame(loop);
      if (document.hidden || !W) return;
      const dt = Math.min((t - last) / 1000 || .016, .05); last = t;
      acc += dt;
      for (; acc > 0.022; acc -= 0.022) {
        flames.push({ x: X(FIRE.x + R(-FIRE.w / 2, FIRE.w / 2)), y: Y(FIRE.y + R(-.01, .01)), vx: R(-6, 6) * W / 200, vy: -R(.05, .1) * H, age: 0, life: R(.35, .6), r: R(.022, .04) * W, ph: R(0, 6.3) });
        if (Math.random() < .55) steam.push({ x: X(POT.x + R(-POT.w / 2, POT.w / 2)), y: Y(POT.y), vx: 0, vy: -R(.05, .09) * H, age: 0, life: R(2, 3), r: R(.012, .02) * W, ph: R(0, 6.3) });
        if (Math.random() < .22) sparks.push({ x: X(FIRE.x + R(-FIRE.w / 2, FIRE.w / 2)), y: Y(FIRE.y), vx: R(-10, 10) * W / 200, vy: -R(.2, .4) * H, age: 0, life: R(.6, 1.1), r: R(.004, .008) * W, ph: 0 });
      }
      g.setTransform(dpr, 0, 0, dpr, 0, 0);
      g.clearRect(0, 0, W, H);

      g.globalCompositeOperation = 'source-over';
      for (let i = steam.length - 1; i >= 0; i--) {
        const p = steam[i]; p.age += dt;
        if (p.age > p.life) { steam.splice(i, 1); continue; }
        const k = p.age / p.life;
        p.x += Math.sin(p.age * 2 + p.ph) * .02 * W * dt * 3; p.y += p.vy * dt;
        const r = p.r * (1 + k * 2.2), a = Math.sin(Math.PI * k) * .3;
        const gr = g.createRadialGradient(p.x, p.y, 0, p.x, p.y, r);
        gr.addColorStop(0, `rgba(255,255,255,${a})`); gr.addColorStop(1, 'rgba(255,255,255,0)');
        g.fillStyle = gr; g.beginPath(); g.arc(p.x, p.y, r, 0, 6.283); g.fill();
      }
      g.globalCompositeOperation = 'lighter';
      for (let i = flames.length - 1; i >= 0; i--) {
        const p = flames[i]; p.age += dt;
        if (p.age > p.life) { flames.splice(i, 1); continue; }
        const k = p.age / p.life;
        p.x += (p.vx + Math.sin(p.age * 14 + p.ph) * W * .02) * dt; p.y += p.vy * dt;
        const r = p.r * (1 - k * .6), a = (1 - k) * .85;
        const gr = g.createRadialGradient(p.x, p.y, 0, p.x, p.y, r);
        gr.addColorStop(0, `rgba(255,${Math.round(240 - 120 * k)},${Math.round(130 - 110 * k)},${a})`);
        gr.addColorStop(.5, `rgba(255,${Math.round(150 - 90 * k)},20,${a * .6})`);
        gr.addColorStop(1, 'rgba(200,30,0,0)');
        g.fillStyle = gr; g.beginPath(); g.arc(p.x, p.y, r, 0, 6.283); g.fill();
      }
      for (let i = sparks.length - 1; i >= 0; i--) {
        const p = sparks[i]; p.age += dt;
        if (p.age > p.life) { sparks.splice(i, 1); continue; }
        p.x += p.vx * dt; p.y += p.vy * dt;
        g.fillStyle = `rgba(255,200,90,${1 - p.age / p.life})`;
        g.beginPath(); g.arc(p.x, p.y, p.r, 0, 6.283); g.fill();
      }
    };
    raf = requestAnimationFrame(loop);
  }
</script>
