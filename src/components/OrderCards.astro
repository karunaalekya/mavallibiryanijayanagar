---
import { cfg, waLink, telLink, callNum, waIcon, brandIcon } from '../lib/site';
const pickup = cfg.pickup || '/contact/';
---
<section class="oc" aria-label="Choose how you want to order">
  <div class="oc-grid">
    <a href={pickup} target="_blank" rel="noopener" class="oc-card oc-main" data-evt="pickup_click">
      <span class="oc-tag">★ MOST PREFERRED</span>
      <span class="oc-ico oc-gold"><svg viewBox="0 0 32 32" width="38" height="38" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M5 13 7 5h18l2 8"/><path d="M5 13v14h22V13"/><path d="M5 13c0 2.200 1.800 3 3.700 3S12.400 15 13 13c.6 2 2 3 3 3s2.400-1 3-3c.6 2 2 3 3.300 3S27 15.200 27 13"/><path d="M13 27v-7h6v7"/></svg></span>
      <h2>Pickup from Outlet</h2>
      <p class="oc-sub">Skip the wait, collect it fresh</p>
      <ul><li>Pick your own time</li><li>No delivery fee</li></ul>
      <small class="oc-note">Opens our online pickup page</small>
      <span class="oc-btn oc-btn-gold">Order Pickup <i aria-hidden="true">→</i></span>
    </a>
    <a href={cfg.swiggy || '#'} class="oc-card obtn-swiggy" data-evt="swiggy_click" data-soon="swiggy">
      <span class="oc-ico"><Fragment set:html={brandIcon.swiggy} /></span>
      <h2>Order on Swiggy</h2>
      <p class="oc-sub">Fast &amp; Reliable Delivery</p>
      <ul><li>Home delivery</li><li>Live order tracking</li></ul>
      <small class="oc-note">Opens Swiggy in a new tab</small>
      <span class="oc-btn">Order on Swiggy <i aria-hidden="true">→</i></span>
    </a>
    <a href={cfg.zomato || '#'} class="oc-card obtn-zomato" data-evt="zomato_click" data-soon="zomato">
      <span class="oc-ico"><Fragment set:html={brandIcon.zomato} /></span>
      <h2>Order on Zomato</h2>
      <p class="oc-sub">Great Food, Great Service</p>
      <ul><li>Easy reorders</li><li>Easy payments</li></ul>
      <small class="oc-note">Opens Zomato in a new tab</small>
      <span class="oc-btn">Order on Zomato <i aria-hidden="true">→</i></span>
    </a>
  </div>
  <div class="oc-alt">
    <a href={waLink()} data-evt="whatsapp_click" class="oc-pill"><svg viewBox="0 0 32 32" width="22" height="22" aria-hidden="true" set:html={waIcon} /> WhatsApp us</a>
    {callNum && <a href={telLink} data-evt="call_click" class="oc-pill">Call +91 {callNum}</a>}
  </div>
</section>
<style>
  .oc-grid{display:grid;gap:3rem 1rem;padding-top:2.2rem}
  @media(min-width:760px){.oc-grid{grid-template-columns:repeat(3,1fr)}}
  .oc-card{position:relative;display:flex;flex-direction:column;align-items:center;text-align:center;background:#FFFBF2;color:var(--color-bark);border:1.5px solid rgba(201,151,60,.45);border-radius:18px;padding:3.2rem 1.1rem 1.2rem;box-shadow:0 8px 24px rgba(40,6,8,.12);transition:transform .2s}
  @media(hover:hover){.oc-card:hover{transform:translateY(-4px)}}
  .oc-card:active{transform:scale(.98)}
  .oc-ico{position:absolute;top:-34px;left:50%;transform:translateX(-50%);display:grid;place-items:center;width:78px;height:78px;border-radius:999px;background:#fff;box-shadow:0 6px 18px rgba(40,6,8,.22);border:3px solid #fff;overflow:hidden}
  .oc-ico :global(svg){width:60px;height:60px}
  .oc-gold{background:linear-gradient(145deg,#E8BC5A,#B8832A);color:var(--color-maroon)}
  .oc-gold svg{width:38px;height:38px}
  .oc-tag{position:absolute;top:-62px;left:50%;transform:translateX(-50%);white-space:nowrap;background:linear-gradient(90deg,#F4C95D,#F08A1F);color:#4a1a00;font-weight:800;font-size:.68rem;letter-spacing:.08em;padding:.3rem .8rem;border-radius:999px;box-shadow:0 3px 10px rgba(0,0,0,.2)}
  .oc-card h2{font-family:var(--font-display);font-size:1.3rem;color:var(--color-maroon);margin:0}
  .oc-sub{font-size:.85rem;opacity:.75;margin:.2rem 0 .8rem;padding-bottom:.8rem;border-bottom:1px solid rgba(201,151,60,.4);width:100%}
  .oc-card ul{list-style:none;padding:0;margin:0 0 .8rem;display:grid;gap:.35rem;font-weight:500}
  .oc-note{font-size:.75rem;opacity:.65;margin-bottom:.8rem}
  .oc-btn{margin-top:auto;display:flex;align-items:center;justify-content:center;gap:.5rem;width:100%;min-height:48px;border-radius:12px;background:var(--color-ink);color:#fff;font-weight:700}
  .oc-btn-gold{background:linear-gradient(145deg,#E8BC5A,#B8832A);color:var(--color-ink)}
  .oc-alt{display:flex;flex-wrap:wrap;gap:.75rem;justify-content:center;margin-top:1.5rem}
  .oc-pill{display:inline-flex;align-items:center;gap:.5rem;min-height:48px;padding:.5rem 1.2rem;border-radius:999px;border:1.5px solid var(--color-gold);color:var(--color-gold);font-weight:700}
</style>
