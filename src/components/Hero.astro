---
import Seal from './Seal.astro';
import { cfg, waLink, telLink, callNum, waIcon, brandIcon, brandName } from '../lib/site';
const wa = waLink();
const chip = (k: string, label: string) =>
  `<a href="${cfg[k] || '#'}" class="chip-app brand brand-${k}" data-soon="${k}" aria-label="${label} coming soon">${brandIcon[k]}<span class="wm">${brandName[k]}</span><em class="pill">soon</em></a>`;
---
<section class="hero relative isolate overflow-hidden text-ivory" aria-label="Mavalli Biryani Jayanagar">
  <div class="hero-bg" aria-hidden="true"></div>
  <canvas id="embers" class="pointer-events-none absolute inset-0 -z-[1] h-full w-full" aria-hidden="true"></canvas>
  <div class="hero-grid mx-auto grid w-full max-w-[1440px] items-center px-5 lg:grid-cols-2 lg:gap-0 lg:px-12">
    <div class="hero-stage lg:order-2">
    <div class="hero-media relative">
      <video id="hv" class="hero-vid" muted playsinline preload="metadata" poster="/video/hero-biryani-poster.webp" width="720" height="720" aria-label="A copper handi of mutton biryani on the table with steam rising">
        <source data-src="/video/hero-biryani.mp4" type="video/mp4">
      </video>
      <button id="hv-btn" type="button" class="hv-btn" aria-label="Pause video" data-state="playing">
        <svg class="i-pause" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M7 5h4v14H7zM13 5h4v14h-4z"/></svg>
        <svg class="i-play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
        <svg class="i-replay" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 5V2L7 6l5 4V7a5 5 0 1 1-5 5H5a7 7 0 1 0 7-7z"/></svg><span class="rp-t">Watch again</span>
      </button>
      <div class="hero-gal" id="hg">
        <figure class="hg a"><img src="/img/hero/g1.webp" alt="Biryani in a copper handi with the lid resting on the side" width="640" height="400" decoding="async"><figcaption>Wood-fire handi biryani</figcaption></figure>
        <figure class="hg b"><img src="/img/hero/g2.webp" alt="Green masala curry in a copper handi" width="640" height="400" decoding="async"><figcaption>Green masala curry</figcaption></figure>
        <figure class="hg c"><img src="/img/hero/g3.webp" alt="Close-up of mutton biryani with jeera samba rice" width="640" height="400" decoding="async"><figcaption>Mutton biryani</figcaption></figure>
      </div>
    </div>
    </div>
    <div class="hero-copy relative z-10 pb-12 lg:order-1 lg:py-28">
      <Seal />
      <p class="rise font-kn text-lg font-bold text-gold" lang="kn">ನಮಸ್ಕಾರ! ಜಯನಗರಕ್ಕೆ ಸ್ವಾಗತ</p>
      <h1 class="hero-h1 mt-3 font-display leading-[1.08]">
        <span class="ln"><span>Mavalli's</span></span>
        <span class="ln"><span>wood-fire biryani,</span></span>
        <span class="ln text-gold"><span>now in Jayanagar</span></span>
      </h1>
      <p class="rise d2 mt-5 max-w-[46ch] text-[1.05rem] text-cream/90 lg:text-lg">Karnataka-style biryani slow-cooked over wood fire in copper handis. Taste of 1952, at our Jayanagar outlet.</p>
      <div class="rise d3 mt-7 flex flex-wrap gap-3">
        <a href={wa} class="btn btn-wa" data-evt="whatsapp_click"><svg viewBox="0 0 32 32" width="22" height="22" aria-hidden="true" set:html={waIcon} />WhatsApp</a>
        <a href="/menu/" class="btn btn-line" data-evt="menu_view">View Menu</a>
      </div>
      <div class="rise d3 mt-6 flex flex-wrap items-center gap-2 text-sm">
        <span class="text-cream/80">Order on</span>
        <Fragment set:html={chip('zomato', 'Zomato') + chip('swiggy', 'Swiggy')} />
        {callNum && <a href={telLink} class="chip-app plain" data-evt="call_click">Call hotel</a>}
        <span class="chip-app plain">Pickup available</span>
      </div>
    </div>
  </div>
</section>
<script>
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saver = (navigator as any).connection?.saveData === true;
  const v = document.getElementById('hv') as HTMLVideoElement | null;
  const b = document.getElementById('hv-btn') as HTMLButtonElement | null;
  if (v && b) {
    const media = v.closest('.hero-media') as HTMLElement;
    let userPaused = saver, visible = true, shown = false, ready = false;
    // after the clip finishes: the photos open through an iris (circle expanding from the centre) over the last frame,
    // then keep irising from one photo to the next. Reduced motion: plain cross-fade.
    const gal = document.getElementById('hg') as HTMLElement;
    const figs = Array.from(gal.querySelectorAll<HTMLElement>('.hg'));
    const ring = document.createElement('span'); ring.className = 'iris-ring'; ring.setAttribute('aria-hidden', 'true'); gal.appendChild(ring);
    let z = 1, idx = 0, timer = 0;
    const EASE = 'cubic-bezier(.16,1,.3,1)';
    const open = (i: number) => {
      const f = figs[i], prev = figs.find((x) => x !== f && x.classList.contains('on'));
      f.style.zIndex = String(++z); ring.style.zIndex = String(z + 1); f.classList.add('on');
      const done = () => { if (prev) prev.classList.remove('on'); };
      if (calm) { f.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 400 }).onfinish = done; return; }
      f.animate([{ clipPath: 'circle(0% at 50% 50%)' }, { clipPath: 'circle(100% at 50% 50%)' }], { duration: 900, easing: EASE }).onfinish = done;
      ring.animate([{ transform: 'scale(0)', opacity: 1 }, { transform: 'scale(.62)', opacity: .9, offset: .7 }, { transform: 'scale(.7)', opacity: 0 }], { duration: 900, easing: EASE });
    };
    const stop = () => { clearInterval(timer); figs.forEach((f) => { f.classList.remove('on'); f.style.zIndex = ''; }); z = 1; idx = 0; };
    const cycle = () => { stop(); open(0); timer = window.setInterval(() => { if (!visible || document.hidden) return; idx = (idx + 1) % figs.length; open(idx); }, 4200); };
    const sync = () => {
      const p = v.paused;
      b.dataset.state = shown ? 'replay' : p ? 'paused' : 'playing';
      b.setAttribute('aria-label', shown ? 'Watch the video again' : p ? 'Play video' : 'Pause video');
    };
    const go = () => { const sc = v.querySelector('source[data-src]') as HTMLSourceElement | null; if (sc) { sc.src = sc.dataset.src!; sc.removeAttribute('data-src'); v.load(); } v.play().then(sync).catch(sync); };
    v.addEventListener('play', sync); v.addEventListener('pause', sync);
    v.addEventListener('ended', () => { shown = true; media.classList.add('is-gal'); cycle(); sync(); });
    b.addEventListener('click', () => {
      if (shown) { shown = false; stop(); media.classList.remove('is-gal'); v.currentTime = 0; userPaused = false; sync(); go(); return; }
      if (v.paused) { userPaused = false; go(); } else { userPaused = true; v.pause(); }
    });
    new IntersectionObserver(([en]) => { visible = en.isIntersecting; if (!visible) v.pause(); else if (!userPaused && !shown && ready) go(); }, { threshold: .25 }).observe(v);
    // start playback only after the page has settled, so the 870 KB clip never competes with first paint on slow links
    addEventListener('load', () => setTimeout(() => { ready = true; if (visible && !userPaused && !shown) go(); }, 1500));
    if (userPaused) sync();
  }
  const c = document.getElementById('embers') as HTMLCanvasElement;
  if (c && !calm && !saver) {
    const start = () => {
      const x = c.getContext('2d')!; let w = 0, h = 0, raf = 0, last = 0;
      const fit = () => { w = c.width = c.offsetWidth; h = c.height = c.offsetHeight; }; fit(); addEventListener('resize', fit);
      const n = innerWidth < 640 ? 10 : 26;
      const p = Array.from({ length: n }, () => ({ x: Math.random() * w, y: Math.random() * h, r: 1 + Math.random() * 2, v: .3 + Math.random() * .8 }));
      const tick = (t: number) => {
        raf = requestAnimationFrame(tick); if (t - last < 33) return; last = t;
        x.clearRect(0, 0, w, h); x.fillStyle = 'rgba(255,150,40,.5)'; x.beginPath();
        for (const e of p) { e.y -= e.v * 2; e.x += Math.sin(e.y / 40) * .8; if (e.y < -5) { e.y = h + 5; e.x = Math.random() * w; } x.moveTo(e.x + e.r, e.y); x.arc(e.x, e.y, e.r, 0, 6.3); }
        x.fill();
      };
      new IntersectionObserver(([en]) => { cancelAnimationFrame(raf); if (en.isIntersecting) raf = requestAnimationFrame(tick); }).observe(c);
    };
    addEventListener('load', () => setTimeout(() => ('requestIdleCallback' in window ? (window as any).requestIdleCallback(start, { timeout: 4000 }) : start()), 3200));
  }
</script>
