---
import { cfg, waIcon, brandIcon, telLink, callNum } from '../lib/site';
const bagIcon = '<svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect width="32" height="32" rx="8" fill="#fff"/><path d="M9 12h14l-1.2 13H10.2L9 12Z" fill="#8E1219"/><path d="M12.5 12v-1.5a3.5 3.5 0 0 1 7 0V12" fill="none" stroke="#8E1219" stroke-width="2"/></svg>';
const dineIcon = '<svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect width="32" height="32" rx="8" fill="#fff"/><circle cx="17" cy="16" r="6.4" fill="none" stroke="#B8662E" stroke-width="2"/><circle cx="17" cy="16" r="2.6" fill="#B8662E"/><path d="M6.5 8v6.5M9 8v6.5M11.5 8v6.5M9 14.5V24M26.5 8c-2.2 1.2-2.2 6.300 0 8V24" fill="none" stroke="#B8662E" stroke-width="1.6" stroke-linecap="round"/></svg>';
---
<div id="wz" class="wz" data-wa={cfg.whatsapp ? `https://wa.me/91${cfg.whatsapp}` : '/order/'} data-swiggy={cfg.swiggy || undefined} data-zomato={cfg.zomato || undefined} data-addr={cfg.address.line}>
  <div id="wz-tip" class="wz-tip" hidden>
    <span lang="kn" class="font-kn font-bold">ನಮಸ್ಕಾರ!</span> Chat with us on WhatsApp
  </div>
  <section id="wz-panel" class="wz-panel" role="dialog" aria-label="Chat with Mavalli Biryani Jayanagar on WhatsApp" hidden>
    <header class="wz-head">
      <span class="wz-av"><img src="/img/logo-sm.webp" alt="Mavalli Biryani logo" width="360" height="232" decoding="async"></span>
      <span class="wz-who"><b>Mavalli Biryani <svg class="wz-ver" viewBox="0 0 24 24" width="16" height="16" aria-label="Official business"><path fill="#25D366" d="M12 1.800l2.400 1.700 2.900-.1 1 2.800 2.400 1.700-.8 2.800.8 2.800-2.400 1.700-1 2.800-2.900-.1L12 20.200l-2.400-1.700-2.900.1-1-2.800-2.400-1.700.8-2.800-.8-2.800 2.400-1.700 1-2.800 2.900.1L12 1.800Z"/><path fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="m8.200 12 2.700 2.700 4.900-5.200"/></svg></b><small><i class="wz-dot"></i> <span id="wz-st">online · Jayanagar</span></small></span>
      <button id="wz-x" type="button" aria-label="Close chat" class="wz-x">✕</button>
    </header>
    <div id="wz-chat" class="wz-chat" aria-live="polite"></div>
    <div id="wz-opts" class="wz-opts" hidden></div>
    <form id="wz-form" class="wz-form" novalidate hidden>
      <label class="wz-l" for="wz-name">Your name</label>
      <input id="wz-name" name="name" type="text" autocomplete="name" placeholder="e.g. Ravi" maxlength="40" required>
      <label class="wz-l" for="wz-phone">Mobile number <em>(optional)</em></label>
      <input id="wz-phone" name="phone" type="tel" inputmode="numeric" autocomplete="tel-national" placeholder="10-digit number" maxlength="14">
      <p id="wz-err" class="wz-err" role="alert" hidden></p>
      <button type="submit" class="wz-go" data-evt="whatsapp_click"><svg viewBox="0 0 32 32" width="22" height="22" aria-hidden="true" set:html={waIcon} /><span id="wz-go-t">Continue on WhatsApp</span></button>
      <div class="wz-alt"><button type="button" id="wz-again" class="wz-link">↺ Change option</button>{callNum && <a href={telLink} class="wz-link" data-evt="call_click">Call hotel · <span lang="kn" class="font-kn">ಕರೆ ಮಾಡಿ</span></a>}</div>
    </form>
    <template id="wz-modes">
      {cfg.swiggy && <button type="button" class="wz-chip" data-m="swiggy"><Fragment set:html={brandIcon.swiggy} /><span>Swiggy<small>Delivery</small></span></button>}
      {cfg.zomato && <button type="button" class="wz-chip" data-m="zomato"><Fragment set:html={brandIcon.zomato} /><span>Zomato<small>Delivery</small></span></button>}
      <button type="button" class="wz-chip" data-m="pickup"><Fragment set:html={bagIcon} /><span>Pickup<small>Take away</small></span></button>
      <button type="button" class="wz-chip" data-m="dine"><Fragment set:html={dineIcon} /><span>Dine-in<small>Book a table</small></span></button>
    </template>
  </section>
  {cfg.instagram && <a id="wz-ig" class="wz-btn wz-ig fab-float" href={cfg.instagram} target="_blank" rel="noopener" aria-label="Mavalli Biryani Jayanagar on Instagram" data-evt="instagram_click">
    <span class="fab-shine" aria-hidden="true"></span>
    <svg class="fab-ico" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5.2"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none"/></svg>
    <span class="wz-pulse" aria-hidden="true"></span>
  </a>}
  <button id="wz-btn" type="button" class="wz-btn fab-float fab-float-2" aria-expanded="false" aria-controls="wz-panel" aria-label="Chat with Mavalli Biryani Jayanagar on WhatsApp">
    <span class="fab-shine" aria-hidden="true"></span>
    <svg class="fab-ico" viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" set:html={waIcon} />
    <span class="wz-pulse" aria-hidden="true"></span>
  </button>
</div>
<style is:global>
  .wz{position:fixed;right:1rem;bottom:4.75rem;z-index:50;display:flex;flex-direction:column;align-items:flex-end;gap:.6rem}
  @media (min-width:1024px){.wz{right:1.5rem;bottom:1.5rem}}
  .wz-btn{position:relative;display:grid;place-items:center;width:60px;height:60px;border-radius:999px;background:var(--color-wa);color:#052E16;box-shadow:0 8px 22px rgba(40,6,8,.4);transition:transform .15s}
  .wz-btn:active{transform:scale(.94)}
  @media (hover:hover){.wz-btn:hover{transform:scale(1.06)}}
  .wz-pulse{position:absolute;inset:0;border-radius:999px;border:2px solid var(--color-wa);pointer-events:none;animation:wzp 2.4s ease-out infinite}
  @keyframes wzp{from{opacity:.7;transform:scale(1)}to{opacity:0;transform:scale(1.6)}}

  /* floating + shining Instagram and WhatsApp buttons: the icons drift top to bottom on a loop, a light sweep crosses each button */
  .wz{gap:.85rem}
  .wz-btn{overflow:visible}
  .wz-ig{background:linear-gradient(45deg,#FEDA75 0%,#FA7E1E 28%,#D62976 55%,#962FBF 78%,#4F5BD5 100%);color:#fff;text-decoration:none;box-shadow:0 8px 22px rgba(40,6,8,.4),0 0 18px rgba(214,41,118,.55)}
  .wz-ig .wz-pulse{border-color:#D62976}
  /* brand colours: WhatsApp green with white icon, Instagram gradient with white icon (override the site-wide gold --color-wa) */
  #wz #wz-btn{background:linear-gradient(145deg,#3BEB85,#25D366 55%,#128C7E);color:#fff;box-shadow:0 8px 22px rgba(40,6,8,.4),0 0 20px rgba(37,211,102,.75)}
  #wz #wz-btn .wz-pulse{border-color:#25D366}
  #wz .wz-ig{color:#fff;animation-name:fabfloat,fabglowig}
  #wz #wz-btn{animation-name:fabfloat,fabglowwa}
  @keyframes fabglowwa{0%,100%{box-shadow:0 8px 22px rgba(40,6,8,.4),0 0 14px rgba(37,211,102,.55)}50%{box-shadow:0 8px 22px rgba(40,6,8,.4),0 0 30px rgba(37,211,102,.95)}}
  @keyframes fabglowig{0%,100%{box-shadow:0 8px 22px rgba(40,6,8,.4),0 0 14px rgba(214,41,118,.55)}50%{box-shadow:0 8px 22px rgba(40,6,8,.4),0 0 30px rgba(214,41,118,.95)}}
  #wz .wz-btn.fab-float{animation-duration:3.2s,2.2s;animation-iteration-count:infinite;animation-timing-function:ease-in-out}
  .wz-panel:not([hidden]) ~ .wz-ig{display:none}
  .fab-shine{position:absolute;inset:0;border-radius:inherit;overflow:hidden;pointer-events:none}
  .fab-shine::before{content:"";position:absolute;top:-25%;bottom:-25%;left:0;width:55%;background:linear-gradient(100deg,transparent 0%,rgba(255,255,255,.95) 50%,transparent 100%);transform:translateX(-170%) skewX(-18deg);animation:fabshine 3.2s ease-in-out infinite}
  .wz-btn:not(.wz-ig) .fab-shine::before{animation-delay:1.1s}
  @keyframes fabshine{0%{transform:translateX(-170%) skewX(-18deg)}45%,100%{transform:translateX(330%) skewX(-18deg)}}
  .fab-ico{position:relative;z-index:1;animation:fabdrift 2.6s ease-in-out infinite}
  .fab-float-2 .fab-ico{animation-delay:-1.3s}
  @keyframes fabdrift{0%,100%{transform:translateY(-5px)}50%{transform:translateY(5px)}}
  .fab-float{animation:fabfloat 3.2s ease-in-out infinite}
  .fab-float-2{animation-delay:-1.6s}
  @keyframes fabfloat{0%,100%{translate:0 -4px}50%{translate:0 4px}}
  .wz-ig:focus-visible,#wz-btn:focus-visible{outline:3px solid #fff;outline-offset:3px}
  @media (prefers-reduced-motion:reduce){.fab-float,#wz .wz-btn.fab-float,.fab-ico,.fab-shine::before{animation:none}.fab-shine::before{display:none}}
  .wz-tip{background:#fff;color:var(--color-bark);border-radius:16px 16px 4px 16px;padding:.6rem .95rem;font-weight:600;box-shadow:0 8px 24px rgba(40,6,8,.25);animation:wzin .35s cubic-bezier(.2,.8,.3,1.2) both}

  /* cool slate-teal chat theme, WhatsApp dark style */
  .wz-panel{--bg:#0B141A;--card:#1B2A31;--line:#2A3D46;--tx:#E8F1EF;--mute:#93A8B0;--wa:#25D366;
    display:flex;flex-direction:column;width:min(92vw,380px);max-height:min(80svh,660px);background:var(--bg);color:var(--tx);border-radius:24px;overflow:hidden;border:1px solid rgba(255,255,255,.08);
    box-shadow:0 22px 60px rgba(2,10,14,.6),0 0 0 1px rgba(37,211,102,.12);transform-origin:bottom right;animation:wzin .35s cubic-bezier(.2,.8,.3,1.2) both}
  .wz-panel[hidden]{display:none}
  .wz-head{display:flex;align-items:center;gap:.7rem;padding:.65rem .8rem;background:linear-gradient(110deg,#12262D,#17383B 60%,#12302F);border-bottom:1px solid rgba(37,211,102,.18);color:var(--tx)}
  .wz-av{flex:none;display:grid;place-items:center;width:52px;height:52px;border-radius:999px;background:radial-gradient(circle at 50% 0%,#FFFBEA,#F2D27C);box-shadow:0 0 0 2px #F3D27A,0 0 14px rgba(255,208,100,.55);padding:5px}
  .wz-av img{width:100%;height:auto;object-fit:contain}
  .wz-who{display:grid;line-height:1.3;min-width:0}.wz-who b{display:flex;align-items:center;gap:.3rem;font-size:.98rem;font-weight:700}.wz-who small{font-size:.84rem;color:#B6D8C6}
  .wz-ver{flex:none}
  .wz-dot{display:inline-block;width:8px;height:8px;border-radius:99px;background:#4ADE80;margin-right:.2rem;box-shadow:0 0 0 3px rgba(74,222,128,.22)}
  .wz-x{margin-left:auto;color:var(--tx);min-width:44px;min-height:44px;font-size:1.05rem;border-radius:999px}
  .wz-x:hover{background:rgba(255,255,255,.08)}
  .wz-chat{flex:1;overflow:auto;display:flex;flex-direction:column;gap:.45rem;padding:1rem .85rem .7rem;min-height:130px;scrollbar-width:thin;scrollbar-color:#2A3D46 transparent;
    background:radial-gradient(rgba(255,255,255,.045) 1px,transparent 1.6px) 0 0/18px 18px,linear-gradient(180deg,#0B141A,#0E1C22)}
  .wb{position:relative;max-width:86%;padding:.5rem .7rem .3rem;border-radius:4px 14px 14px 14px;background:var(--card);color:var(--tx);font-size:1rem;line-height:1.5;box-shadow:0 1px 2px rgba(0,0,0,.35);animation:wzin .25s ease-out both}
  .wb.me{align-self:flex-end;background:linear-gradient(135deg,#0B6B58,#075E54);border-radius:14px 4px 14px 14px}
  .wb .tx{display:block;overflow-wrap:anywhere}.wb .meta{display:flex;justify-content:flex-end;align-items:center;gap:.25rem;margin-top:.05rem;font-size:.72rem;color:var(--mute);line-height:1.2}
  .wb.me .meta{color:#B8E3D3}
  .wb .tick{width:17px;height:11px;color:#9FB6BD;transition:color .3s}.wb .tick.read{color:#53BDEB}
  .wb .caret{display:inline-block;width:2px;height:1em;margin-left:1px;vertical-align:-.12em;background:var(--wa);animation:wzc .8s steps(1) infinite}
  @keyframes wzc{50%{opacity:0}}
  .wb.dots{display:flex;gap:4px;padding:.8rem .9rem}.wb.dots i{width:7px;height:7px;border-radius:99px;background:#8FA7AF;animation:wzd 1s ease-in-out infinite}.wb.dots i:nth-child(2){animation-delay:.15s}.wb.dots i:nth-child(3){animation-delay:.3s}
  @keyframes wzd{0%,60%,100%{transform:none;opacity:.5}30%{transform:translateY(-4px);opacity:1}}
  a.wb.act{display:flex;align-items:center;gap:.5rem;padding:.65rem .9rem;font-weight:700;color:#9BF0BE;border:1px solid rgba(37,211,102,.5);text-decoration:none}
  a.wb.act:hover{background:#21353D}
  .wz-opts{display:grid;grid-template-columns:1fr 1fr;gap:.5rem;padding:.7rem .8rem .85rem;background:#101E25;border-top:1px solid var(--line);animation:wzin .3s ease-out both}
  .wz-opts[hidden]{display:none}.wz-opts.g{grid-template-columns:repeat(4,1fr)}
  .wz-chip{display:flex;align-items:center;gap:.55rem;min-height:52px;padding:.45rem .65rem;border-radius:16px;text-align:left;background:rgba(37,211,102,.08);border:1px solid rgba(37,211,102,.5);color:#D6F7E4;font-weight:700;font-size:1rem;line-height:1.15;transition:background .15s,transform .15s,border-color .15s}
  .wz-chip svg{flex:none;width:30px;height:30px;border-radius:8px}
  .wz-chip>span{white-space:nowrap}.wz-chip small{display:block;margin-top:.1rem;font-size:.74rem;font-weight:600;color:#93C9AB}
  .wz-chip:active{transform:scale(.97)}
  @media (hover:hover){.wz-chip:hover{background:rgba(37,211,102,.18);border-color:#25D366}}
  .wz-chip:focus-visible,.wz-x:focus-visible,.wz-link:focus-visible{outline:2px solid #9BF0BE;outline-offset:2px}
  .wz-opts.g .wz-chip{justify-content:center;text-align:center;padding:.4rem .2rem;font-size:.95rem}
  .wz-form{display:grid;gap:.35rem;padding:.75rem .9rem .85rem;background:#101E25;border-top:1px solid var(--line);animation:wzin .3s ease-out both}
  .wz-form[hidden]{display:none}
  .wz-l{font-size:.88rem;font-weight:700;color:#BFD3D9}.wz-l em{font-style:normal;font-weight:500;color:var(--mute)}
  .wz-form input{width:100%;min-height:46px;padding:.55rem .85rem;border-radius:12px;border:1.5px solid #34505B;background:#1B2A31;color:#fff;font-size:1rem}
  .wz-form input::placeholder{color:#7F98A1}
  .wz-form input:focus{outline:none;border-color:#25D366;box-shadow:0 0 0 3px rgba(37,211,102,.22)}
  .wz-form input[aria-invalid=true]{border-color:#FF8A80}
  .wz-err{font-size:.9rem;font-weight:600;color:#FFA59C}.wz-err[hidden]{display:none}
  .wz-go{display:flex;align-items:center;justify-content:center;gap:.5rem;min-height:50px;margin-top:.35rem;border-radius:999px;background:linear-gradient(135deg,#3CE985,#25D366 55%,#16A34A);color:#052E16;font-weight:800;font-size:1.05rem;box-shadow:0 8px 20px rgba(37,211,102,.28)}
  .wz-go:active{transform:scale(.98)}
  .wz-alt{display:flex;justify-content:space-between;gap:.5rem;flex-wrap:wrap}
  .wz-link{padding:.5rem .3rem;min-height:40px;font-size:.92rem;font-weight:600;color:#9FC8B3;text-decoration:underline;text-underline-offset:3px;background:none}
  @keyframes wzin{from{opacity:0;transform:translateY(10px) scale(.96)}to{opacity:1;transform:none}}
  @media (prefers-reduced-motion:reduce){.wz-pulse,.wb.dots i,.wb .caret{animation:none}.wz-tip,.wz-panel,.wb,.wz-form,.wz-opts{animation:none}}
</style>
<script>
  const wz = document.getElementById('wz')!;
  const btn = document.getElementById('wz-btn')!, panel = document.getElementById('wz-panel')!, tip = document.getElementById('wz-tip')!, x = document.getElementById('wz-x')!;
  const chat = document.getElementById('wz-chat')!, form = document.getElementById('wz-form') as HTMLFormElement, opts = document.getElementById('wz-opts')!;
  const nameI = document.getElementById('wz-name') as HTMLInputElement, phoneI = document.getElementById('wz-phone') as HTMLInputElement, err = document.getElementById('wz-err')!;
  const goT = document.getElementById('wz-go-t')!, again = document.getElementById('wz-again')!;
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const st = document.getElementById('wz-st')!; const idle = st.textContent!;
  type Mode = 'swiggy' | 'zomato' | 'pickup' | 'dine';
  let started = false, run = 0, fast = false, mode: Mode | null = null, guests = '';
  const wait = (ms: number) => new Promise<void>((r) => setTimeout(r, fast || calm ? 0 : ms));
  const rnd = (a: number, b: number) => a + Math.random() * (b - a);
  const rows = ['qwertyuiop', 'asdfghjkl', 'zxcvbnm'];
  const near = (ch: string) => { for (const r of rows) { const i = r.indexOf(ch); if (i > -1) return r[i + (i > 0 && Math.random() < .5 ? -1 : 1)] ?? r[i - 1]; } return ''; };
  const down = () => { chat.scrollTop = chat.scrollHeight; };
  const hhmm = () => new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  const tickSvg = '<svg class="tick" viewBox="0 0 17 11" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M1 5.800 4 9 10 1.500M6.500 8.800 7 9.200 13 1.500M10.500 6.200 16 1.500"/></svg>';
  const bubble = (cls = '') => { const b = document.createElement('div'); b.className = 'wb ' + cls; chat.appendChild(b); down(); return b; };
  const addMeta = (b: HTMLElement, me: boolean) => { const m = document.createElement('span'); m.className = 'meta'; m.innerHTML = hhmm() + (me ? tickSvg : ''); b.appendChild(m); return m; };
  const userSay = async (text: string) => {
    const b = bubble('me'); const tx = document.createElement('span'); tx.className = 'tx'; tx.textContent = text; b.appendChild(tx); addMeta(b, true); down();
    await wait(450); b.querySelector('.tick')?.classList.add('read');
  };
  // human-style typing: uneven speed, longer pauses after words and punctuation, the odd slip that gets corrected
  const humanType = async (node: Text, text: string, id: number) => {
    const chars = Array.from(text);
    for (let i = 0; i < chars.length; i++) {
      if (id !== run) return;
      if (fast || calm) { node.nodeValue = text; return; }
      const ch = chars[i];
      if (i > 3 && /[a-z]/.test(ch) && Math.random() < .045) {
        const bad = near(ch);
        if (bad) { node.nodeValue += bad; await wait(rnd(140, 260)); node.nodeValue = node.nodeValue!.slice(0, -1); await wait(rnd(90, 160)); }
      }
      node.nodeValue += ch; down();
      let d = rnd(28, 75);
      if (ch === ' ') d += rnd(0, 50);
      if (/[,.!?]/.test(ch)) d += rnd(140, 260);
      if (Math.random() < .05) d += rnd(150, 350);
      await wait(d);
    }
  };
  const botSay = async (text: string, id: number) => {
    st.textContent = 'typing…';
    const d = bubble('dots'); d.innerHTML = '<i></i><i></i><i></i>'; d.setAttribute('aria-label', 'typing');
    await wait(rnd(500, 800) + Math.min(text.length * 9, 600)); if (id !== run) return false;
    d.className = 'wb'; d.innerHTML = ''; d.removeAttribute('aria-label');
    const tx = document.createElement('span'); tx.className = 'tx'; const t = document.createTextNode(''); const c = document.createElement('span'); c.className = 'caret'; tx.append(t, c); d.appendChild(tx);
    await humanType(t, text, id); if (id !== run) return false;
    t.nodeValue = text; c.remove(); addMeta(d, false); st.textContent = idle; await wait(rnd(250, 450)); return true;
  };
  const hideAll = () => { opts.hidden = true; form.hidden = true; };
  const showModes = () => {
    const tpl = document.getElementById('wz-modes') as HTMLTemplateElement;
    opts.className = 'wz-opts'; opts.innerHTML = ''; opts.appendChild(tpl.content.cloneNode(true)); opts.hidden = false; down();
    opts.querySelectorAll<HTMLButtonElement>('.wz-chip').forEach((b) => b.addEventListener('click', () => pick(b.dataset.m as Mode, (b.querySelector('span')!.firstChild as Text).nodeValue!)));
    (opts.querySelector('.wz-chip') as HTMLElement)?.focus({ preventScroll: true });
  };
  const showGuests = () => {
    opts.className = 'wz-opts g'; opts.innerHTML = '';
    ['1–2', '3–4', '5–6', '7+'].forEach((g) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'wz-chip'; b.textContent = g; b.addEventListener('click', () => pickGuests(g)); opts.appendChild(b); });
    opts.hidden = false; down(); (opts.querySelector('.wz-chip') as HTMLElement)?.focus({ preventScroll: true });
  };
  const askName = () => { form.hidden = false; down(); nameI.focus({ preventScroll: true }); };
  const label = (m: Mode) => ({ swiggy: 'Swiggy', zomato: 'Zomato', pickup: 'Pickup', dine: 'Dine-in' }[m]);
  const pick = async (m: Mode, text: string) => {
    mode = m; guests = ''; hideAll(); const id = ++run;
    await userSay(m === 'dine' ? 'Dine-in 🍽️' : m === 'pickup' ? 'Pickup 🥡' : `${label(m)} 🛵`);
    const addr = wz.dataset.addr || 'Jayanagar';
    if (m === 'swiggy' || m === 'zomato') {
      const url = wz.dataset[m]; const nm = label(m);
      if (url) {
        if (!await botSay(`${nm} it is! 🛵 Tap below and we will get it to you hot.`, id)) return;
        const a = document.createElement('a'); a.className = 'wb act'; a.href = url; a.target = '_blank'; a.rel = 'noopener'; a.textContent = `Open ${nm} →`; a.dataset.evt = `${m}_click`; chat.appendChild(a); down();
        if (!await botSay('Prefer WhatsApp? Share your name and we will take your order directly.', id)) return;
      } else {
        if (!await botSay(`${nm} is coming soon to Jayanagar 🛵`, id)) return;
        if (!await botSay('Till then, order right here on WhatsApp. Same menu, same wood fire. Your name, please?', id)) return;
      }
    } else if (m === 'pickup') {
      if (!await botSay(`Pickup it is 🥡 We are at ${addr}.`, id)) return;
      if (!await botSay('Your name, please? We will keep it hot and packed.', id)) return;
    } else {
      if (!await botSay('Lovely, a table for you! 🍽️ How many of you?', id)) return;
      showGuests(); return;
    }
    goT.textContent = 'Continue on WhatsApp'; askName();
  };
  const pickGuests = async (g: string) => {
    guests = g; hideAll(); const id = ++run;
    await userSay(`${g} people`);
    if (!await botSay('Perfect! 🙌 Your name, please?', id)) return;
    askName();
  };
  const play = async () => {
    started = true; const id = ++run;
    if (!await botSay('ನಮಸ್ಕಾರ! 🙏 Welcome to Mavalli Biryani, Jayanagar.', id)) return;
    if (!await botSay('Wood-fire biryani since 1952. How would you like to enjoy it today?', id)) return;
    showModes();
  };
  again.addEventListener('click', async () => { hideAll(); const id = ++run; mode = null; guests = ''; if (!await botSay('Sure, pick another option 👇', id)) return; showModes(); });
  chat.addEventListener('click', () => { fast = true; });
  const set = (o: boolean) => { panel.hidden = !o; btn.setAttribute('aria-expanded', String(o)); if (o) { tip.hidden = true; if (!started) play(); } };
  btn.addEventListener('click', () => { set(panel.hidden); (window as any).dataLayer?.push({ event: 'welcome_open' }); });
  x.addEventListener('click', () => { set(false); btn.focus(); });
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) { set(false); btn.focus(); } });
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = nameI.value.trim().replace(/\s+/g, ' '); const digits = phoneI.value.replace(/\D/g, '').replace(/^(91|0)(?=\d{10}$)/, '');
    nameI.removeAttribute('aria-invalid'); phoneI.removeAttribute('aria-invalid'); err.hidden = true;
    if (name.length < 2) { nameI.setAttribute('aria-invalid', 'true'); err.textContent = 'Please tell us your name.'; err.hidden = false; nameI.focus(); return; }
    if (phoneI.value.trim() && !/^[6-9]\d{9}$/.test(digits)) { phoneI.setAttribute('aria-invalid', 'true'); err.textContent = 'Enter a valid 10-digit mobile number, or leave it empty.'; err.hidden = false; phoneI.focus(); return; }
    const how = mode === 'pickup' ? 'I would like to order for pickup.' : mode === 'dine' ? `I would like to book a table for ${guests || 'a few'} people (dine-in).` : mode === 'swiggy' || mode === 'zomato' ? `I would like a delivery order (${label(mode)}).` : 'I want to order.';
    const msg = `ನಮಸ್ಕಾರ! Hi Mavalli Biryani Jayanagar, I'm ${name}.` + (digits ? ` My number is +91 ${digits}.` : '') + ' ' + how;
    const base = wz.dataset.wa!; const url = base.startsWith('http') ? `${base}?text=${encodeURIComponent(msg)}` : base;
    (window as any).dataLayer?.push({ event: 'whatsapp_click' });
    // open inside the tap itself so phone browsers do not block the new tab
    const a = document.createElement('a'); a.href = url; a.target = '_blank'; a.rel = 'noopener'; document.body.appendChild(a); a.click(); a.remove();
    form.hidden = true; const id = ++run;
    await userSay(`I'm ${name}${digits ? ' · +91 ' + digits : ''}`);
    if (!await botSay(`Thank you, ${name}! 🙏 Opening WhatsApp for you now.`, id)) return;
    goT.textContent = 'Open WhatsApp again'; form.hidden = false; down();
  });
  const desk = matchMedia('(min-width:1024px)');
  const place = () => wz.classList.toggle('on', desk.matches || scrollY > 420);
  addEventListener('scroll', place, { passive: true }); desk.addEventListener('change', place); addEventListener('load', () => setTimeout(place, 400));
  let seen = false; try { seen = sessionStorage.getItem('wz') === '1'; } catch {}
  const showTip = () => { if (panel.hidden && wz.classList.contains('on')) { tip.hidden = false; try { sessionStorage.setItem('wz', '1'); } catch {} setTimeout(() => tip.hidden = true, 6000); } };
  if (!seen) setTimeout(showTip, 5000);
</script>
